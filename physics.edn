;; What this occupation's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a secure document-handling and archival robot
;; performs trade-confirmation printing, disclosure packet assembly and
;; physical archival (ISCO 3311 securities and finance dealers and brokers).
;; Its physical work: lifting assembled disclosure packets from the printer
;; output to the mailing tray, and archiving confirmations in a fire-resistant
;; record cabinet whose wall must keep paper below its char point in a fire.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3311"
 :cases
 [{:id :disclosure-packets-to-mail-tray
   :kind :manipulator
   :procedure "arm lifts a stack of assembled disclosure packets from the printer output bin to the mailing tray"
   :params {:l1-m 0.40 :l2-m 0.35 :m1-kg 3.5 :m2-kg 2.5
            :from [0.50 0.10] :to [0.20 0.60] :duration-s 2.0 :steps 400}
   :sweep {:param :payload-kg :values [0.5 1.0 2.5 5.0 7.5]}
   :quantity :peak-tau1-nm
   :limit {:max 50.0 :basis "estimate: continuous shoulder torque of a light (~5 kg-payload) collaborative arm"}
   :boundary {:lo 0.1 :hi 20.0}}
  {:id :record-cabinet-fire-wall
   :kind :thermal
   :procedure "one hour of furnace exposure (wall face held at 927 °C, no cool-down modeled) on the insulated wall of the record cabinet the robot archives into; interior face temperature"
   :params {:conductivity-w-mk 0.12 :density-kg-m3 900.0 :specific-heat-j-kgk 1000.0
            :t0-c 20.0 :t-hot-c 927.0 :front-fixed? true :t-back-ambient-c 20.0 :h-back-w-m2k 5.0
            :threshold-c 177.0 :duration-s 3600.0}
   :sweep {:param :thickness-m :values [0.02 0.03 0.04 0.06 0.08]}
   :quantity :final-back-c
   :limit {:max 177.0 :basis "UL 72 Class 350 (paper records): interior must not exceed 350 °F (177 °C) during the fire-endurance test"}
   :boundary {:lo 0.01 :hi 0.08}}]}
